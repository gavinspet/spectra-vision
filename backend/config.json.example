{
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "threadCount": 16,
    "logPath": "./logs",
    "logLevel": "info"
  },
  "security": {
    "enableAuth": true,
    "rateLimitRps": 100,
    "jwtSecret": "change-me-in-production"
  },
  "models": [
    {
      "modelId": "emotion-v2",
      "modelPath": "./models/emotion_v2.onnx",
      "modelType": "onnx",
      "detectionStrategy": "emotion-classification",
      "classLabels": ["angry", "disgust", "fear", "happy", "neutral", "sad", "surprise"],
      "inputShape": {
        "batch": 1,
        "channels": 3,
        "height": 224,
        "width": 224
      },
      "confidenceThreshold": 0.5,
      "nmsThreshold": 0.45
    }
  ]
}
